{
  "mcpServers": {
    "endpoint": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/run-with-uv",
      "args": [
        "run",
        "--locked",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "--extra",
        "integration",
        "hpc-bridge"
      ],
      "env": {
        "HPC_BRIDGE_USER_DIR": "${CLAUDE_PLUGIN_DATA}/globus_compute"
      }
    }
  }
}
